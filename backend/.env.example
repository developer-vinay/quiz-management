# JWT Secret for authentication
JWT_SECRET=JWT_SECRET

# Server Port
PORT=5000

# MongoDB Connection URI
MONGODB_URI=MONGO_URI

# Encryption Key for sensitive data
ENCRYPTION_KEY=ENCRYPTION_KEY

# Email Configuration for sending registration emails
# You need to set up Gmail App Password for this to work
EMAIL_USER=EMAIL_USER
EMAIL_PASS= EMAIL_PASS

# Instructions for setting up Gmail App Password:
# 1. Go to your Google Account settings
# 2. Enable 2-Factor Authentication if not already enabled
# 3. Go to Security > App passwords
# 4. Generate a new app password for "Mail"
# 5. Use that 16-character password as EMAIL_PASS
# 6. Use your Gmail address as EMAIL_USER
